{
  "name": "xjtu-launcher",
  "private": true,
  "version": "0.4.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "format": "prettier --write src plugins examples *.json *.ts index.html src-tauri/*.json src-tauri/capabilities/*.json",
    "format:check": "prettier --check src plugins examples *.json *.ts index.html src-tauri/*.json src-tauri/capabilities/*.json",
    "dev:frontend": "vite --host 127.0.0.1",
    "app:build": "tauri build",
    "market:serve": "node tools/plugin-server/server.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "dompurify": "^3.4.17",
    "lucide-vue-next": "^0.468.0",
    "marked": "^18.1.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.1.0"
  }
}
